# Copy this file to `.env` and fill in your key: `cp .env.example .env`
# Bun loads `.env` automatically when the server starts.

# Your nanoGPT API key (https://nano-gpt.com, under API settings). Required.
NANOGPT_API_KEY=

# Everything below is optional; the values shown are the defaults.

# Where the server listens. 127.0.0.1 means only this phone can connect,
# which is what you want: the chat has no password.
# HOST=127.0.0.1
# PORT=4747

# Other names you open the app by, besides localhost and IP addresses
# (comma-separated), like a Tailscale machine name. Others are refused.
# ALLOWED_HOSTS=

# Folder where your chat and settings are saved.
# DATA_DIR=./data

# nanoGPT's OpenAI-compatible API address. You only change this for testing.
# NANOGPT_BASE_URL=https://nano-gpt.com/api/v1

# How long to wait for a reply before giving up, in seconds.
# Slow reasoning models can need a while.
# REQUEST_TIMEOUT_SECONDS=180

# The developer panel: every private note of a kinwriter in one view, for checking
# the tools while Kinaera is being built (docs/orientation-3.md). Their prompt
# tells them the developer may open it. Off unless set to 1.
# DEVELOPER_PANEL=1
